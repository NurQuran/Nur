{"1":["اُ۪قْتَرَبَتِ اِ۬لسَّاعَةُ وَانشَقَّ اَ۬لْقَمَرُۖ",[[3,4,"qlq"],[21,22,"madda_normal"],[30,31,"ikhf"]]],"2":["وَإِنْ يَّرَوَاْ اٰيَةٗ يُعْرِضُواْ وَيَقُولُواْ سِحْرٞ مُّسْتَمِرّٞۖ",[[7,9,"idgh_ghn"],[17,19,"warsh_naql"],[24,25,"idgh_ghn"],[32,33,"madda_normal"],[42,43,"madda_normal"],[45,46,"madda_normal"],[56,58,"idgh_ghn"]]],"3":["وَكَذَّبُواْ وَاتَّبَعُوٓاْ أَهْوَآءَهُمْۖ وَكُلُّ أَمْرٖ مُّسْتَقِرّٞۖ",[[9,10,"madda_normal"],[23,25,"madda_permissible"],[34,36,"madda_permissible"],[59,61,"idgh_ghn"]]],"4":["وَلَقَدْ جَآءَهُم مِّنَ اَ۬لَانۢبَآءِ مَا فِيهِ مُزْدَجَرٌۖ",[[6,7,"qlq"],[11,13,"madda_permissible"],[19,21,"idgh_ghn"],[29,31,"warsh_naql"],[31,32,"iqlb"],[35,37,"madda_permissible"],[42,43,"madda_normal"],[46,47,"madda_normal"]]],"5":["حِكْمَةُۢ بَٰلِغَةٞۖ فَمَا تُغْنِ اِ۬لنُّذُرُۖ",[[8,9,"iqlb"],[12,13,"madda_normal"],[18,19,"ikhf"],[25,26,"madda_normal"],[38,40,"ghn"]]],"6":["فَتَوَلَّ عَنْهُمْۖ يَوْمَ يَدْعُ اُ۬لدَّاعِۦٓ إِلَىٰ شَےْءٖ نُّكُرٍ",[[29,30,"qlq"],[41,42,"madda_normal"],[44,46,"madda_permissible"],[51,53,"madda_normal"],[56,57,"madda_permissible"],[61,63,"idgh_ghn"]]],"7":["خُشَّعاً اَبْصَٰرُهُمْ يَخْرُجُونَ مِنَ اَ۬لَاجْدَاثِ كَأَنَّهُمْ جَرَادٞ مُّنتَشِرٞ",[[9,11,"warsh_naql"],[11,12,"qlq"],[15,16,"madda_normal"],[31,32,"madda_normal"],[44,46,"warsh_naql"],[46,47,"qlq"],[50,51,"madda_normal"],[58,60,"ghn"],[70,71,"madda_normal"],[74,76,"idgh_ghn"],[77,78,"ikhf"]]],"8":["مُّهْطِعِينَ إِلَى اَ۬لدَّاعِۦۖ يَقُولُ اُ۬لْكَٰفِرُونَ هَٰذَا يَوْمٌ عَسِرٞۖ",[[9,10,"madda_normal"],[26,27,"madda_normal"],[29,30,"madda_normal"],[36,37,"madda_normal"],[47,48,"madda_normal"],[52,53,"madda_normal"],[58,59,"madda_normal"],[61,62,"madda_normal"]]],"9":["كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٖ فَكَذَّبُواْ عَبْدَنَا وَقَالُواْ مَجْنُونٞ وَازْدُجِرَۖ",[[12,13,"qlq"],[30,31,"madda_normal"],[32,33,"ikhf"],[43,44,"madda_normal"],[49,50,"qlq"],[55,56,"madda_normal"],[61,62,"madda_normal"],[64,65,"madda_normal"],[70,71,"qlq"],[74,75,"madda_normal"],[78,79,"idgh_gh