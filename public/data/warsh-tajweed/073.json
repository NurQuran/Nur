{"1":["يَٰٓأَيُّهَا اَ۬لْمُزَّمِّلُ قُمِ اِ۬ليْلَ إِلَّا قَلِيلاٗ",[[2,4,"madda_permissible"],[23,25,"ghn"],[48,49,"madda_normal"],[54,55,"madda_normal"],[56,57,"madda_permissible"]]],"2":["نِّصْفَهُۥٓ أَوُ اُ۟نقُصْ مِنْهُ قَلِيلاً",[[9,11,"madda_permissible"],[20,21,"ikhf"],[37,38,"madda_normal"],[39,40,"madda_permissible"]]],"3":["اَوْ زِدْ عَلَيْهِ وَرَتِّلِ اِ۬لْقُرْءَانَ تَرْتِيلاًۖ",[[7,8,"qlq"],[40,41,"madda_permissible"],[50,51,"madda_normal"],[52,53,"madda_permissible"]]],"4":["اِنَّا سَنُلْقِے عَلَيْكَ قَوْلاٗ ثَقِيلاًۖ",[[2,4,"ghn"],[5,6,"madda_normal"],[15,16,"madda_normal"],[32,33,"ikhf"],[38,39,"madda_normal"],[40,41,"madda_permissible"]]],"5":["اِنَّ نَاشِيـَٔةَ اَ۬ليْلِ هِيَ أَشَدُّ وَطْــٔاٗ وَأَقْوَمُ قِيلاًۖ",[[2,4,"ghn"],[8,9,"madda_normal"],[42,43,"qlq"],[50,51,"idgh_ghn"],[54,55,"qlq"],[63,64,"madda_normal"],[65,66,"madda_permissible"]]],"6":["اِنَّ لَكَ فِے اِ۬لنَّه۪ارِ سَبْحاٗ طَوِيلاٗۖ",[[2,4,"ghn"],[19,21,"ghn"],[24,25,"madda_normal"],[30,31,"qlq"],[34,35,"ikhf"],[40,41,"madda_normal"],[42,43,"madda_permissible"]]],"7":["وَاذْكُرِ اِ۪سْمَ رَبِّكَ وَتَبَتَّلِ اِلَيْهِ تَبْتِيلاٗۖ",[[35,36,"warsh_naql"],[38,39,"warsh_naql"],[49,50,"qlq"],[53,54,"madda_normal"],[55,56,"madda_permissible"]]],"8":["رَّبُّ اُ۬لْمَشْرِقِ وَالْمَغْرِبِۖ لَآ إِلَٰهَ إِلَّا هُوَۖ فَاتَّخِذْهُ وَكِيلاٗۖ",[[38,40,"madda_permissible"],[45,46,"madda_normal"],[54,55,"madda_normal"],[79,80,"madda_normal"],[81,82,"madda_permissible"]]],"9":["وَاصْبِرْ عَلَىٰ مَا يَقُولُونَۖ وَاهْجُرْهُمْ هَجْراٗ جَمِيلاٗۖ",[[14,16,"madda_normal"],[19,20,"madda_normal"],[25,26,"madda_normal"],[28,29,"madda_normal"],[49,50,"qlq"],[53,54,"ikhf"],[59,60,"madda_normal"],[61,62,"madda_permissible"]]],"10":["وَذَرْنِے وَالْمُكَذِّبِينَ أُوْلِے اِ۬لنَّعْمَةِ وَمَهِّلْهُمْ قَلِيلاًۖ",[[8,9,"madda_normal"],[24,25,"madda_normal"],[40,42,"ghn"],[68,69,"madda_normal"],[70,71,"madda_permissible"]]],"11":["اِنَّ لَدَيْنَآ أَنكَالاٗ وَجَحِيماٗ",[[2,4,"ghn"],[14,16,"madda_permissible"],[19,20,"ikhf"],[22,23,"madda_normal"],[27,28,"idgh_ghn"],[33,34,"madda_normal"],[35,36,"madda_permissible"]]],"12":["وَطَعَاماٗ ذَا غُصَّةٖ وَعَذَاباً اَلِيماٗ",[[6,7,"madda_normal"],[9,10,"ikhf"],[13,14,"madda_normal"],[23,24,"idgh_ghn"],[29,30,"madda_normal"],[34,36,"warsh_naql"],[38,39,"madda_normal"],[40,41,"madda_permissible"]]],"13":["يَوْمَ تَرْجُفُ اُ۬لَارْضُ وَالْجِبَالُ وَكَانَتِ اِ۬لْجِبَالُ كَثِيباٗ مَّهِيلاًۖ",[[20,22,"warsh_naql"],[36,37,"madda_normal"],[44,45,"madda_normal"],[59,60,"madda_normal"],[67,68,"madda_normal"],[72,74,"idgh_ghn"],[77,78,"madda_normal"],[79,80,"madda_permissible"]]],"14":["اِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولاٗ شَٰهِداً عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَىٰ فِرْعَوْنَ رَسُولاٗ",[[2,4,"ghn"],[5,7,"madda_permissible"],[18,20,"madda_permissible"],[36,37,"madda_normal"],[39,40,"ikhf"],[43,44,"madda_normal"],[65,67,"madda_permissible"],[78,80,"madda_permissible"],[85,87,"madda_normal"],[103,104,"madda_normal"],[105,106,"madda_permissible"]]],"15":["فَعَص۪ىٰ فِرْعَوْنُ اُ۬لرَّسُولَ فَأَخَذْنَٰهُ أَخْذاٗ وَبِيلاٗۖ",[[6,8,"madda_normal"],[29,30,"madda_normal"],[43,44,"madda_normal"],[55,56,"idgh_ghn"],[59,60,"madda_normal"],[61,62,"madda_permissible"]]],"16":["فَكَيْفَ تَتَّقُونَ إِن كَفَرْتُمْ يَوْماٗ يَجْعَلُ اُ۬لْوِلْدَٰنَ شِيباً اِ۬لسَّمَآءُ مُنفَطِرُۢ بِهِۦۖ كَانَ وَعْدُهُۥ مَفْعُولاًۖ",[[16,17,"madda_normal"],[22,23,"ikhf"],[43,44,"idgh_ghn"],[45,46,"qlq"],[63,64,"madda_normal"],[69,70,"madda_normal"],[83,85,"madda_permissible"],[90,91,"ikhf"],[97,98,"iqlb"],[103,104,"madda_normal"],[108,109,"madda_normal"],[120,121,"madda_normal"],[128,129,"madda_normal"],[130,131,"madda_permissible"]]],"17":["اِنَّ هَٰذِهِۦ تَذْكِرَةٞۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلاًۖ",[[2,4,"ghn"],[8,9,"madda_normal"],[13,14,"madda_normal"],[24,25,"ikhf"],[31,32,"ikhf"],[35,37,"madda_permissible"],[55,57,"madda_normal"],[65,66,"madda_normal"],[71,72,"madda_normal"],[73,74,"madda_permissible"]]],"18":["۞ اِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْن۪ىٰ مِن ثُلُثَيِ اِ۬ليْلِ وَنِصْفِهِۦ وَثُلُثِهِۦ وَطَآئِفَةٞ مِّنَ اَ۬لذِينَ مَعَكَۖ وَاللَّهُ يُقَدِّرُ اُ۬ليْلَ وَالنَّهَارَۖ عَلِمَ أَن لَّن تُحْصُوهُ فَتَابَ عَلَيْكُمْۖ فَاقْرَءُواْ مَا تَيَسَّرَ مِنَ اَ۬لْقُرْءَانِۖ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْض۪ىٰ وَءَاخَرُونَ يَضْرِبُونَ فِے اِ۬لَارْضِ يَبْتَغُونَ مِن فَضْلِ اِ۬للَّهِ وَءَاخَرُونَ يُقَٰتِلُونَ فِے سَبِيلِ اِ۬للَّهِۖ فَاقْرَءُواْ مَا تَيَسَّرَ مِنْهُۖ وَأَقِيمُواْ اُ۬لصَّلَوٰةَ وَءَاتُواْ اُ۬لزَّكَوٰةَۖ وَأَقْرِضُواْ اُ۬للَّهَ قَرْضاً حَسَناٗۖ وَمَا تُقَدِّمُواْ لِأَنفُسِكُم مِّنْ خَيْرٖ تَجِدُوهُ عِندَ اَ۬للَّهِ هُوَ خَيْراٗ وَأَعْظَمَ أَجْراٗۖ وَاسْتَغْفِرُواْ اُ۬للَّهَۖ إِنَّ اَ۬للَّهَ غَفُورٞ رَّحِيمٞۖ",[[4,6,"ghn"],[27,29,"ghn"],[37,38,"madda_normal"],[43,44,"qlq"],[47,49,"madda_normal"],[52,53,"ikhf"],[82,83,"madda_normal"],[94,95,"madda_normal"],[100,102,"madda_permissible"],[109,111,"idgh_ghn"],[121,122,"madda_normal"],[139,140,"madda_normal"],[166,168,"ghn"],[171,172,"madda_normal"],[187,189,"idgh_ghn"],[190,191,"ikhf"],[198,199,"madda_normal"],[206,207,"madda_normal"],[225,226,"qlq"],[231,232,"madda_permissible"],[237,238,"madda_normal"],[265,266,"madda_permissible"],[279,280,"ikhf"],[287,288,"madda_normal"],[293,294,"ikhf"],[298,300,"idgh_ghn"],[305,307,"madda_normal"],[312,313,"madda_permissible"],[317,318,"madda_normal"],[329,330,"madda_normal"],[341,343,"warsh_naql"],[350,351,"qlq"],[356,357,"madda_normal"],[362,363,"ikhf"],[377,378,"madda_normal"],[385,386,"madda_permissible"],[390,391,"madda_normal"],[398,399,"madda_normal"],[403,404,"madda_normal"],[409,410,"madda_normal"],[415,416,"madda_normal"],[425,426,"madda_normal"],[433,434,"qlq"],[439,440,"madda_permissible"],[445,446,"madda_normal"],[471,472,"madda_normal"],[487,489,"madda_normal"],[496,497,"madda_permissible"],[512,514,"madda_normal"],[522,523,"qlq"],[538,539,"madda_normal"],[559,560,"idgh_ghn"],[563,564,"madda_normal"],[574,575,"madda_normal"],[582,583,"ikhf"],[591,593,"idgh_ghn"],[602,603,"ikhf"],[610,611,"madda_normal"],[616,617,"ikh